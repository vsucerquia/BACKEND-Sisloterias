# Copiar a .env y completar (no subir .env a Git).

# PostgreSQL (Neon u otro). Ejemplo:
# DATABASE_URL=postgresql://usuario:clave@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT (mínimo ~32 caracteres en producción)
SECRET_KEY=cambiar-por-clave-larga-y-secreta-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS: orígenes separados por coma (Render: añade URLs de Firebase Hosting)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:3000,http://localhost:4200,http://127.0.0.1:4200,https://TU-PROYECTO.web.app,https://TU-PROYECTO.firebaseapp.com

# Seeder idempotente (usuario para POST /auth/login)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=cambiar-en-produccion

# Cliente HTTP / menú (opcional)
API_BASE_URL=http://127.0.0.1:8000
# Token Bearer tras hacer login (opcional, para herramientas que llamen la API)
API_BEARER_TOKEN=
